# Copy to .env for local development. Never commit real values.
DATABASE_URL="postgresql://doctor:doctor@localhost:5432/doctorfinder"

# Single password for the review queue, partner view and waitlist admin.
ADMIN_PASSWORD="change-me"
# Secret used to hash the daily anonymous token for full reports. Any long random string.
TOKEN_SECRET="change-me-too"

# Extraction. LLM_PROVIDER is "anthropic", "openai", "cohere" or "mock" (offline keyword reader for local testing).
# For Cohere: LLM_PROVIDER="cohere", LLM_MODEL="command-r7b-12-2024" (the default for cohere), LLM_API_KEY=<Cohere key>.
LLM_PROVIDER="anthropic"
LLM_MODEL="claude-opus-5-5"
LLM_API_KEY=""

EXPIRY_DAYS=30
WAITLIST_RADIUS_KM=8
OFFER_BATCH_SIZE=3
OFFER_WINDOW_HOURS=72

# Exact HTTPS clinic hostnames reviewed by the pilot administrator, comma separated.
# Empty disables batch eligibility; individual review still works. Pasted URLs are not verification.
CLINIC_SOURCE_HOSTS=

# Ontario discovery: scheduled monitoring is opt-in; manual source approval is always required.
DISCOVERY_ENABLED=false
# off | brave. Set the secret server-side; never put it in the repository.
DISCOVERY_SEARCH_PROVIDER=off
BRAVE_SEARCH_API_KEY=
# Patient search uses approximate FSA representative points within this radius.
SEARCH_RADIUS_KM=75
