# Copy to .env for local development. Never commit real values.
DATABASE_URL="postgresql://doctor:doctor@localhost:5432/doctorfinder"

# Single password for the review queue, partner view and waitlist admin.
ADMIN_PASSWORD="change-me"
# Secret used to hash the daily anonymous token for full reports. Any long random string.
TOKEN_SECRET="change-me-too"

# Extraction. LLM_PROVIDER is "anthropic", "openai" or "mock" (offline keyword reader for local testing).
LLM_PROVIDER="anthropic"
LLM_MODEL="claude-opus-5-5"
LLM_API_KEY=""

EXPIRY_DAYS=30
WAITLIST_RADIUS_KM=8
OFFER_BATCH_SIZE=3
OFFER_WINDOW_HOURS=72
