generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProviderType {
  family_doctor
  nurse_practitioner
}

enum ListingStatus {
  pending
  live
  expired
  full
}

enum WaitlistChannel {
  sms
  email
}

enum WaitlistStatus {
  waiting
  offered
  accepted
  passed
  left
}

model Listing {
  id              String        @id @default(cuid())
  clinic          String
  area            String
  fsa             String?
  lat             Float
  lng             Float
  providerType    ProviderType  @map("provider_type")
  languages       String[]
  phone           String?
  sourceType      String        @map("source_type")
  sourceUrl       String?       @map("source_url")
  rawText         String?       @map("raw_text")
  /// Per-field confidence from the extraction, plus the model's note.
  confidence      Json?
  status          ListingStatus @default(pending)
  lastConfirmedAt DateTime?     @map("last_confirmed_at")
  expiresAt       DateTime?     @map("expires_at")
  isSample        Boolean       @default(false) @map("is_sample")
  createdAt       DateTime      @default(now()) @map("created_at")
  fullReports     FullReport[]
  languageReports LanguageReport[]
  offers          Offer[]
  proposals       AgentProposal[]

  @@index([status, expiresAt])
  @@map("listings")
}

enum ProposalStatus {
  pending
  approved
  rejected
}

/// Something an agent wants to change. Nothing changes until a reviewer approves it in /admin.
model AgentProposal {
  id         String         @id @default(cuid())
  /// "intake" or "freshness"
  agent      String
  /// reconfirm_listing, mark_full, recheck_listing, or no_listing
  action     String
  listingId  String?        @map("listing_id")
  /// Action details, e.g. the confirmed date or the call script for a re-check.
  payload    Json
  rationale  String
  priority   String         @default("normal")
  /// Every tool call the agent made, in order, with its result.
  trace      Json
  rawText    String?        @map("raw_text")
  status     ProposalStatus @default(pending)
  createdAt  DateTime       @default(now()) @map("created_at")
  decidedAt  DateTime?      @map("decided_at")
  listing    Listing?       @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
  @@map("agent_proposals")
}

model FullReport {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")
  /// sha256 of (secret, date, network address). Changes every day. The address itself is never stored.
  tokenHash String   @map("token_hash")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, tokenHash])
  @@map("full_reports")
}

/// After calling, a patient says whether the clinic spoke their language. Nothing about the patient is stored.
model LanguageReport {
  id        String   @id @default(cuid())
  listingId String   @map("listing_id")
  /// English language name, as in listing data, e.g. "Arabic".
  language  String
  /// "spoke", "interpreter" or "neither"
  outcome   String
  /// sha256 of (secret, date, network address), as for full reports. The address itself is never stored.
  tokenHash String   @map("token_hash")
  createdAt DateTime @default(now()) @map("created_at")
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, language, tokenHash])
  @@index([listingId])
  @@map("language_reports")
}

model FsaCentroid {
  fsa String @id
  lat Float
  lng Float

  @@map("fsa_centroids")
}

/// Counters only. No row describes a person.
model DailyCount {
  date                  DateTime @db.Date
  fsa                   String
  language              String
  isSample              Boolean  @default(false) @map("is_sample")
  searches              Int      @default(0)
  searchesNoLangMatch   Int      @default(0) @map("searches_with_no_language_match")
  listingOpens          Int      @default(0) @map("listing_opens")
  fullReports           Int      @default(0) @map("full_reports")

  @@id([date, fsa, language, isSample])
  @@map("daily_counts")
}

/// Sample rows only. is_sample is always true.
model WaitlistEntry {
  id            String          @id @default(cuid())
  label         String
  fsa           String
  language      String
  channel       WaitlistChannel
  joinedAt      DateTime        @map("joined_at")
  status        WaitlistStatus  @default(waiting)
  lastCheckinAt DateTime        @map("last_checkin_at")
  isSample      Boolean         @default(true) @map("is_sample")
  offers        Offer[]
  messages      OutboxMessage[]

  @@index([status, joinedAt])
  @@map("waitlist_entries")
}

model Offer {
  id         String          @id @default(cuid())
  listingId  String          @map("listing_id")
  entryId    String          @map("entry_id")
  sentAt     DateTime        @default(now()) @map("sent_at")
  respondBy  DateTime        @map("respond_by")
  /// null while open. accepted, passed, no_reply, or closed (someone else accepted).
  response   String?
  listing    Listing         @relation(fields: [listingId], references: [id], onDelete: Cascade)
  entry      WaitlistEntry   @relation(fields: [entryId], references: [id], onDelete: Cascade)
  messages   OutboxMessage[]

  @@index([listingId, response])
  @@map("offers")
}

/// What would be sent. Nothing here is ever delivered.
model OutboxMessage {
  id        String        @id @default(cuid())
  entryId   String        @map("entry_id")
  offerId   String?       @map("offer_id")
  kind      String
  body      String
  createdAt DateTime      @default(now()) @map("created_at")
  entry     WaitlistEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  offer     Offer?        @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@map("outbox_messages")
}

/// Immutable snapshots of human publication decisions. Shared admin is not an individual identity.
model ReviewDecision {
  id        String   @id @default(cuid())
  mode      String
  action    String
  actor     String   @default("shared_admin")
  policy    String
  items     Json
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("review_decisions")
}

/// A discovered public page. Review is required before the crawler fetches it.
model DiscoverySource {
  id            String   @id @default(cuid())
  url           String   @unique
  host          String
  title         String   @default("")
  kind          String   @default("unknown")
  status        String   @default("pending")
  trustedClinic Boolean  @default(false) @map("trusted_clinic")
  foundBy       String   @default("manual") @map("found_by")
  query         String?
  /// The search result's short description, when the search gave one. Shown to the triage agent; never fetched.
  snippet       String   @default("")
  /// What the triage agent chose: watch_clinic, watch_directory, dismiss or ask_human. Null until it sorts the page.
  triageDecision String? @map("triage_decision")
  triageReason  String?  @map("triage_reason")
  triagedAt     DateTime? @map("triaged_at")
  isSample      Boolean  @default(false) @map("is_sample")
  lastCheckedAt DateTime? @map("last_checked_at")
  nextCheckAt   DateTime @default(now()) @map("next_check_at")
  lastHash      String?  @map("last_hash")
  lastError     String?  @map("last_error")
  leaseUntil    DateTime? @map("lease_until")
  reviewedAt    DateTime? @map("reviewed_at")
  createdAt     DateTime @default(now()) @map("created_at")
  checks        DiscoveryCheck[]

  @@index([status, nextCheckAt])
  @@map("discovery_sources")
}

/// Immutable source evidence; retrieval time is never an availability confirmation.
model DiscoveryCheck {
  id            String   @id @default(cuid())
  sourceId      String   @map("source_id")
  contentHash   String   @map("content_hash")
  sourceUrl     String   @map("source_url")
  title         String
  excerpt       String
  publishedDate String?  @map("published_date")
  retrievedAt   DateTime @default(now()) @map("retrieved_at")
  status        String   @default("queued")
  outcomeKind   String?  @map("outcome_kind")
  outcomeId     String?  @map("outcome_id")
  error         String?
  source        DiscoverySource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@unique([sourceId, contentHash])
  @@index([retrievedAt])
  @@map("discovery_checks")
}

/// Daily search budget shared by scheduled jobs and manual runs.
model DiscoverySearchState {
  id             String    @id
  lastSearchedAt DateTime?  @map("last_searched_at")
  nextSearchAt   DateTime   @default(now()) @map("next_search_at")
  leaseUntil     DateTime?  @map("lease_until")
  lastError      String?    @map("last_error")
  /// The triage agent's last run (planner, model, steps), shown on the discovery page.
  lastTriage     Json?      @map("last_triage")

  @@map("discovery_search_state")
}
